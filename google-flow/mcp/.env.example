# ============================================================================
# flow-mcp Environment Configuration (.env.example)
# ============================================================================

# Directory storing the isolated Chrome profile (chrome-profile), local auth token, and uploads
FLOW_MCP_HOME=C:\Users\madha\.flow-mcp

# Directory where generated stills, video clips, and assembled films are saved
FLOW_MCP_OUTPUT=C:\Users\madha\flow-mcp-out

# Google Chrome executable path on Windows
FLOW_MCP_CHROME=C:\Program Files\Google\Chrome\Application\chrome.exe

# Chrome DevTools Protocol (CDP) port used to control the dedicated Chrome window
FLOW_MCP_CDP_PORT=9333

# Local HTTP port for Flow Studio control panel (http://127.0.0.1:8787)
FLOW_MCP_PORT=8787

# FFmpeg and FFprobe binaries (used to join clips, mix audio, and extract frames)
FLOW_MCP_FFMPEG=ffmpeg
FLOW_MCP_FFPROBE=ffprobe

# Optional: Google AI Studio API key (free) for Gemini text-to-speech voice narration
GEMINI_API_KEY=

# Gemini TTS model used when GEMINI_API_KEY is provided
FLOW_MCP_GEMINI_TTS=gemini-2.5-flash-preview-tts
